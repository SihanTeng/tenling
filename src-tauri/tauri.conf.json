{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TenLing",
  "version": "0.3.3",
  "identifier": "com.tenling.app",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "TenLing",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "rpm",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "TenLing \u2014 Markdown viewer and editor",
    "longDescription": "TenLing is a calm, cross-platform Markdown viewer and editor with WYSIWYG editing and present mode.",
    "copyright": "Copyright \u00a9 TenLing contributors",
    "publisher": "Brighteng",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QTVEMTQ5RTlBODc0QjgKUldTNGRLanBTZEdsK2I4NDBTdDUyeFF4dEF5MjBLL20xWVB3SWJic3pmeGo2b2huUk5NbThuWkoK",
      "endpoints": [
        "https://github.com/SihanTeng/tenling/releases/latest/download/latest.json"
      ]
    }
  }
}
