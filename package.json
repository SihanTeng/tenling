{
  "name": "tenling",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "vite",
    "dev:desktop": "bash scripts/dev.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:installers": "bash scripts/build-installers.sh",
    "icons": "python3 scripts/generate-icon.py",
    "version": "bash scripts/bump-version.sh",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "ios:init": "tauri ios init --ci",
    "build:ios": "bash scripts/build-ios.sh --export-method app-store-connect",
    "build:mac:appstore": "bash scripts/build-mac-appstore.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.rs": [
      "bash scripts/lint-rust-staged.sh"
    ]
  },
  "dependencies": {
    "@remotion/player": "^4.0.496",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-character-count": "^3.28.0",
    "@tiptap/extension-code-block-lowlight": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "docx": "^9.7.1",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.496",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
